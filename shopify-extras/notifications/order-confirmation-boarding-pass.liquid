{%- comment -%}
  Flytz Co. — order confirmation email styled as a boarding pass.
  Paste into Shopify admin → Settings → Notifications → Customer notifications → Order confirmation → Edit code.
  Uses only standard notification variables; tables + inline styles for email-client compatibility.
{%- endcomment -%}
{%- liquid
  assign gold = '#C9A24B'
  assign ink = '#1C1917'
  assign muted = '#8C8366'
  assign paper = '#F4EFE4'
  assign night = '#0B0F17'
  assign passenger = shipping_address.name | default: billing_address.name | default: customer.name | default: customer.first_name | upcase
  assign dest_city = shipping_address.city | default: billing_address.city
  assign dest_code = shipping_address.country_code | default: billing_address.country_code
  if dest_city != blank
    assign dest_code = dest_city | remove: ' ' | remove: '-' | remove: '.' | slice: 0, 3 | upcase
  endif
  assign flight = order_number | prepend: 'FZ '
  assign barcode_digits = order_number | append: '7319264805' | append: order_number | split: ''
-%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Boarding pass {{ order_name }}</title>
  <style>
    @media (max-width: 600px) {
      .fz-stack { display: block !important; width: 100% !important; box-sizing: border-box !important; }
      .fz-stub { border-left: 0 !important; border-top: 2px dashed #B4A87F !important; }
      .fz-pad { padding: 20px !important; }
      .fz-code { font-size: 34px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:{{ night }};">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ night }};">
    <tr>
      <td align="center" style="padding:32px 12px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;">
          <tr>
            <td align="center" style="padding:0 0 22px;font-family:Montserrat,Helvetica,Arial,sans-serif;font-size:13px;letter-spacing:6px;font-weight:600;color:#EEF1F7;">
              {%- if shop.email_logo_url -%}
                <img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width | default: 140 }}" style="display:block;border:0;max-width:200px;">
              {%- else -%}
                <span style="color:{{ gold }};">&#9992;</span>&nbsp; {{ shop.name | upcase }}
              {%- endif -%}
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:0 0 8px;font-family:Montserrat,Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:5px;font-weight:600;color:{{ gold }};text-transform:uppercase;">
              You're cleared for departure
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:0 16px 26px;font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif;font-size:34px;line-height:1.2;color:#EEF1F7;">
              {%- if customer.first_name -%}Bon voyage, {{ customer.first_name }}.{%- else -%}Bon voyage.{%- endif -%}
            </td>
          </tr>

          <!-- Boarding pass -->
          <tr>
            <td>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ paper }};border-radius:16px;">
                <tr>
                  <td class="fz-stack fz-pad" valign="top" style="padding:24px 26px;font-family:Montserrat,Helvetica,Arial,sans-serif;color:{{ ink }};">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="font-size:10px;letter-spacing:3px;font-weight:700;color:#8A6D2C;padding-bottom:12px;border-bottom:1px dashed #C9BD9C;">{{ shop.name | upcase }} AIRWAYS</td>
                        <td align="right" style="font-size:10px;letter-spacing:3px;font-weight:700;color:#8A6D2C;padding-bottom:12px;border-bottom:1px dashed #C9BD9C;">BOARDING PASS</td>
                      </tr>
                    </table>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0;">
                      <tr>
                        <td valign="bottom" style="width:40%;">
                          <div style="font-size:9px;letter-spacing:3px;font-weight:600;color:{{ muted }};">FROM</div>
                          <div class="fz-code" style="font-family:'Cormorant Garamond',Georgia,serif;font-size:42px;line-height:1;font-weight:600;color:{{ ink }};">FLZ</div>
                          <div style="font-size:11px;color:#6B6348;">{{ shop.name }} Atelier</div>
                        </td>
                        <td align="center" valign="middle" style="width:20%;font-size:24px;color:#8A6D2C;">&#9992;</td>
                        <td align="right" valign="bottom" style="width:40%;">
                          <div style="font-size:9px;letter-spacing:3px;font-weight:600;color:{{ muted }};">TO</div>
                          <div class="fz-code" style="font-family:'Cormorant Garamond',Georgia,serif;font-size:42px;line-height:1;font-weight:600;color:{{ ink }};">{{ dest_code | default: 'YOU' }}</div>
                          <div style="font-size:11px;color:#6B6348;">{{ dest_city | default: 'Your door' }}</div>
                        </td>
                      </tr>
                    </table>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px dashed #C9BD9C;">
                      <tr>
                        <td style="padding-top:14px;width:34%;" valign="top">
                          <div style="font-size:8px;letter-spacing:2px;font-weight:600;color:{{ muted }};">PASSENGER</div>
                          <div style="font-size:13px;font-weight:700;padding-top:3px;">{{ passenger | default: 'TRAVELLER' }}</div>
                        </td>
                        <td style="padding-top:14px;width:33%;" valign="top">
                          <div style="font-size:8px;letter-spacing:2px;font-weight:600;color:{{ muted }};">FLIGHT</div>
                          <div style="font-size:13px;font-weight:700;padding-top:3px;">{{ flight }}</div>
                        </td>
                        <td style="padding-top:14px;width:33%;" valign="top">
                          <div style="font-size:8px;letter-spacing:2px;font-weight:600;color:{{ muted }};">DATE</div>
                          <div style="font-size:13px;font-weight:700;padding-top:3px;">{{ created_at | date: '%d %b %Y' | upcase }}</div>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding-top:12px;" valign="top">
                          <div style="font-size:8px;letter-spacing:2px;font-weight:600;color:{{ muted }};">GATE</div>
                          <div style="font-size:13px;font-weight:700;padding-top:3px;">G7</div>
                        </td>
                        <td style="padding-top:12px;" valign="top">
                          <div style="font-size:8px;letter-spacing:2px;font-weight:600;color:{{ muted }};">SEAT</div>
                          <div style="font-size:13px;font-weight:700;padding-top:3px;">1A · FIRST</div>
                        </td>
                        <td style="padding-top:12px;" valign="top">
                          <div style="font-size:8px;letter-spacing:2px;font-weight:600;color:{{ muted }};">TOTAL PAID</div>
                          <div style="font-size:13px;font-weight:700;padding-top:3px;">{{ total_price | money_with_currency }}</div>
                        </td>
                      </tr>
                    </table>

                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:16px;border-top:1px dashed #C9BD9C;">
                      <tr>
                        <td colspan="2" style="padding:12px 0 6px;font-size:8px;letter-spacing:2px;font-weight:600;color:{{ muted }};">CABIN BAG</td>
                      </tr>
                      {%- for line in subtotal_line_items -%}
                        <tr>
                          <td style="padding:3px 0;font-size:12px;color:#3D3828;">
                            {{ line.quantity }} × {{ line.product.title | default: line.title }}
                            {%- if line.variant.title != blank and line.variant.title != 'Default Title' %} <span style="color:{{ muted }};">· {{ line.variant.title }}</span>{% endif -%}
                          </td>
                          <td align="right" style="padding:3px 0;font-size:12px;color:#3D3828;white-space:nowrap;">{{ line.final_line_price | money }}</td>
                        </tr>
                      {%- endfor -%}
                      <tr>
                        <td style="padding:8px 0 0;font-size:11px;color:{{ muted }};border-top:1px solid #E2D8C0;">Subtotal</td>
                        <td align="right" style="padding:8px 0 0;font-size:11px;color:{{ muted }};border-top:1px solid #E2D8C0;">{{ subtotal_price | money }}</td>
                      </tr>
                      {%- if shipping_price > 0 or requires_shipping -%}
                        <tr>
                          <td style="padding:2px 0;font-size:11px;color:{{ muted }};">Shipping{% if shipping_method.title %} · {{ shipping_method.title }}{% endif %}</td>
                          <td align="right" style="padding:2px 0;font-size:11px;color:{{ muted }};">{{ shipping_price | money }}</td>
                        </tr>
                      {%- endif -%}
                      {%- if tax_price > 0 -%}
                        <tr>
                          <td style="padding:2px 0;font-size:11px;color:{{ muted }};">Taxes</td>
                          <td align="right" style="padding:2px 0;font-size:11px;color:{{ muted }};">{{ tax_price | money }}</td>
                        </tr>
                      {%- endif -%}
                    </table>
                  </td>

                  <!-- Stub -->
                  <td class="fz-stack fz-stub" valign="middle" align="center" width="128" style="width:128px;border-left:2px dashed #B4A87F;padding:22px 14px;font-family:Montserrat,Helvetica,Arial,sans-serif;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center">
                      <tr>
                        {%- for d in barcode_digits limit: 18 -%}
                          {%- assign w = d | plus: 0 | modulo: 3 | plus: 1 -%}
                          <td width="{{ w }}" height="74" bgcolor="#2A2518" style="width:{{ w }}px;height:74px;background:#2A2518;font-size:0;line-height:0;">&nbsp;</td>
                          <td width="2" height="74" style="width:2px;height:74px;font-size:0;line-height:0;">&nbsp;</td>
                        {%- endfor -%}
                      </tr>
                    </table>
                    <div style="padding-top:12px;font-size:9px;letter-spacing:2px;font-weight:700;color:#6B6348;">ORDER</div>
                    <div style="font-size:13px;font-weight:700;color:{{ ink }};">{{ order_name }}</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td align="center" style="padding:28px 0 8px;">
              <a href="{{ order_status_url }}" style="display:inline-block;padding:15px 34px;border-radius:999px;background:{{ gold }};color:#15120A;font-family:Montserrat,Helvetica,Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:2px;text-decoration:none;text-transform:uppercase;">Track your flight</a>
            </td>
          </tr>
          {%- if shipping_address -%}
            <tr>
              <td align="center" style="padding:18px 20px 0;font-family:Montserrat,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.7;color:#9AA5B8;">
                Landing at {{ shipping_address.address1 }}{% if shipping_address.address2 != blank %}, {{ shipping_address.address2 }}{% endif %}, {{ shipping_address.city }}{% if shipping_address.zip != blank %} {{ shipping_address.zip }}{% endif %}, {{ shipping_address.country }}
              </td>
            </tr>
          {%- endif -%}
          <tr>
            <td align="center" style="padding:26px 20px 0;font-family:Montserrat,Helvetica,Arial,sans-serif;font-size:11px;line-height:1.7;color:#5F6A7D;">
              Questions about your order? Reply to this email or contact <a href="mailto:{{ shop.email }}" style="color:#E7CF96;">{{ shop.email }}</a>.<br>
              {{ shop.name }} · Travel-inspired clothing
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
