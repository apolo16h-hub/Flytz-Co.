{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <section class="flytz-cta section-{{ section.id }}-padding">
    <div class="page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="flytz-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="flytz-cta__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.button_label != blank -%}
        <a class="button" href="{{ section.settings.button_link | default: '#flytz-explorer' }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Flytz call to action",
  "tag": "div",
  "class": "section flytz-section-cta",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Final call"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your next destination is already in your wardrobe."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop by destination"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to scroll to the destination explorer."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "Flytz call to action"
    }
  ]
}
{% endschema %}
