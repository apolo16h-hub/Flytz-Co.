{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign reveal = ''
  if settings.animations_reveal_on_scroll
    assign reveal = ' scroll-trigger animate--slide-in'
  endif
-%}

{%- capture icon_warm -%}<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><circle cx="16" cy="16" r="6"/><path d="M16 3v4M16 25v4M3 16h4M25 16h4M6.8 6.8l2.8 2.8M22.4 22.4l2.8 2.8M6.8 25.2l2.8-2.8M22.4 9.6l2.8-2.8"/></svg>{%- endcapture -%}
{%- capture icon_mild -%}<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M4 12h15a4 4 0 1 0-4-4M4 18h20a4 4 0 1 1-4 4M4 24h9"/></svg>{%- endcapture -%}
{%- capture icon_cool -%}<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M16 3v26M4.7 9.5l22.6 13M4.7 22.5l22.6-13M12.5 5l3.5 3 3.5-3M12.5 27l3.5-3 3.5 3"/></svg>{%- endcapture -%}
{%- capture icon_culture -%}<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M4 12 16 5l12 7M6 12v12M11 12v12M16 12v12M21 12v12M26 12v12M3 27h26"/></svg>{%- endcapture -%}
{%- capture icon_city -%}<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M3 28h26M6 28V14h6v14M12 28V6h8v22M20 28V11h6v17M15 10h2M15 14h2M15 18h2M8.5 18h1M22.5 16h1"/></svg>{%- endcapture -%}
{%- capture icon_nature -%}<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M2 26 12 10l6 9 3-4 9 11H2Z"/><path d="m10 13.5 2 1.5 2-1.5"/></svg>{%- endcapture -%}
{%- capture icon_coast -%}<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M3 20c3 0 3-2 6.5-2s3.5 2 6.5 2 3-2 6.5-2 3.5 2 6.5 2M3 26c3 0 3-2 6.5-2s3.5 2 6.5 2 3-2 6.5-2 3.5 2 6.5 2"/><circle cx="22" cy="9" r="4"/></svg>{%- endcapture -%}
{%- capture icon_tailored -%}<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M11 4 16 9l5-5 6 3 2 9-4 1v11H7V17l-4-1 2-9 6-3ZM16 9v19M13 19h1"/></svg>{%- endcapture -%}
{%- capture icon_relaxed -%}<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M11 5c1.5 2 3 3 5 3s3.5-1 5-3l7 4-3 6-3-1v14H10V14l-3 1-3-6 7-4Z"/></svg>{%- endcapture -%}
{%- capture icon_technical -%}<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M12 4h8l1 3 6 3 1 8-3 1v9H7v-9l-3-1 1-8 6-3 1-3ZM16 8v20M12 4c0 3 1.5 5 4 5s4-2 4-5"/></svg>{%- endcapture -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <section id="flytz-quiz" class="flytz-quiz section-{{ section.id }}-padding" aria-labelledby="FlytzQuizTitle-{{ section.id }}">
    <div class="page-width">
      <div class="flytz-head{{ reveal }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="flytz-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="FlytzQuizTitle-{{ section.id }}" class="flytz-title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="flytz-sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>

      <flytz-quiz class="flytz-quiz__frame" data-origin="{{ section.settings.origin_code | default: 'FLZ' | escape }}">
        <script type="application/json" data-quiz-destinations>
          {%- if section.settings.destinations == blank -%}
            {%- render 'flytz-demo-destinations' -%}
          {%- else -%}
            [
            {%- for c in section.settings.destinations -%}
              {%- capture meta -%}{%- render 'flytz-destination-meta', collection: c -%}{%- endcapture -%}
              {%- liquid
                assign m = meta | strip | split: '|'
                assign tagline = c.metafields.flytz.tagline.value | default: c.description | strip_html | strip_newlines | truncatewords: 30
              -%}
              {"handle": {{ c.handle | json }}, "title": {{ c.title | json }}, "url": {{ c.url | json }}, "code": {{ m[1] | default: '' | json }}, "monument": {{ m[2] | json }}, "palette": {{ m[3] | json }}, "tagline": {{ tagline | json }}}
              {%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
            ]
          {%- endif -%}
        </script>

        <p class="flytz-quiz__count" data-quiz-count data-template="{{ 'flytz.quiz.step' | t: n: '[n]', total: 3 | escape }}" aria-live="polite">{{ 'flytz.quiz.step' | t: n: 1, total: 3 }}</p>
        <div class="flytz-quiz__progress" aria-hidden="true"><span></span><span></span><span></span></div>

        <fieldset class="flytz-quiz__step is-active" data-step="0">
          <legend class="flytz-quiz__q">{{ 'flytz.quiz.q1' | t }}</legend>
          <div class="flytz-quiz__options">
            <button type="button" class="flytz-quiz__option" data-key="weather" data-value="warm">{{ icon_warm }}<span>{{ 'flytz.quiz.warm' | t }}</span><small>{{ 'flytz.quiz.warm_hint' | t }}</small></button>
            <button type="button" class="flytz-quiz__option" data-key="weather" data-value="mild">{{ icon_mild }}<span>{{ 'flytz.quiz.mild' | t }}</span><small>{{ 'flytz.quiz.mild_hint' | t }}</small></button>
            <button type="button" class="flytz-quiz__option" data-key="weather" data-value="cool">{{ icon_cool }}<span>{{ 'flytz.quiz.cool' | t }}</span><small>{{ 'flytz.quiz.cool_hint' | t }}</small></button>
          </div>
        </fieldset>

        <fieldset class="flytz-quiz__step" data-step="1" hidden>
          <legend class="flytz-quiz__q">{{ 'flytz.quiz.q2' | t }}</legend>
          <div class="flytz-quiz__options flytz-quiz__options--4">
            <button type="button" class="flytz-quiz__option" data-key="day" data-value="culture">{{ icon_culture }}<span>{{ 'flytz.quiz.culture' | t }}</span></button>
            <button type="button" class="flytz-quiz__option" data-key="day" data-value="city">{{ icon_city }}<span>{{ 'flytz.quiz.city' | t }}</span></button>
            <button type="button" class="flytz-quiz__option" data-key="day" data-value="nature">{{ icon_nature }}<span>{{ 'flytz.quiz.nature' | t }}</span></button>
            <button type="button" class="flytz-quiz__option" data-key="day" data-value="coast">{{ icon_coast }}<span>{{ 'flytz.quiz.coast' | t }}</span></button>
          </div>
        </fieldset>

        <fieldset class="flytz-quiz__step" data-step="2" hidden>
          <legend class="flytz-quiz__q">{{ 'flytz.quiz.q3' | t }}</legend>
          <div class="flytz-quiz__options">
            <button type="button" class="flytz-quiz__option" data-key="pack" data-value="tailored">{{ icon_tailored }}<span>{{ 'flytz.quiz.tailored' | t }}</span></button>
            <button type="button" class="flytz-quiz__option" data-key="pack" data-value="relaxed">{{ icon_relaxed }}<span>{{ 'flytz.quiz.relaxed' | t }}</span></button>
            <button type="button" class="flytz-quiz__option" data-key="pack" data-value="technical">{{ icon_technical }}<span>{{ 'flytz.quiz.technical' | t }}</span></button>
          </div>
        </fieldset>

        <div class="flytz-quiz__result" data-step="result" hidden>
          <div class="flytz-stage flytz-quiz__stage" aria-hidden="true">
            <div class="flytz-quiz__code" data-result-code></div>
            <div class="flytz-stage__tilt"></div>
            <flytz-landmark data-mode="panel"></flytz-landmark>
          </div>
          <div class="flytz-quiz__result-body">
            <p class="flytz-eyebrow">{{ 'flytz.quiz.result' | t }}</p>
            <p class="flytz-quiz__route" data-result-route></p>
            <h3 class="flytz-quiz__dest" data-result-title tabindex="-1"></h3>
            <p class="flytz-quiz__tagline" data-result-tagline></p>
            <div class="flytz-quiz__ctas">
              <a class="button" href="{{ routes.all_products_collection_url }}" data-result-open>{{ 'flytz.quiz.open' | t }}</a>
              <button type="button" class="button button--secondary" data-quiz-restart>{{ 'flytz.quiz.restart' | t }}</button>
            </div>
          </div>
        </div>

        {%- comment -%} Drawn landmarks for the result when 3D is off or unavailable. {%- endcomment -%}
        {%- assign monuments = 'eiffel,bigben,colosseum,parthenon,fuji,greatwall,tajmahal,burj,pyramids,koutoubia,liberty,chichen,redeemer,machu,opera,globe' | split: ',' -%}
        {%- for m in monuments -%}
          <template data-monument="{{ m }}">{%- render 'flytz-monument', monument: m -%}</template>
        {%- endfor -%}
      </flytz-quiz>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Flytz destination quiz",
  "tag": "div",
  "class": "section flytz-section-quiz",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Not sure where to fly?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your next destination"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Three quick questions. We'll match you with the capsule made for your kind of trip."
    },
    {
      "type": "collection_list",
      "id": "destinations",
      "label": "Destination collections",
      "limit": 20,
      "info": "The quiz picks from these. Sample destinations are used until you choose collections."
    },
    {
      "type": "text",
      "id": "origin_code",
      "label": "Origin code on the result",
      "default": "FLZ"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Flytz destination quiz"
    }
  ]
}
{% endschema %}
