{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign reveal = ''
  if settings.animations_reveal_on_scroll
    assign reveal = ' scroll-trigger animate--slide-in'
  endif
  assign c = section.settings.collection
  assign monument = 'globe'
  assign code = ''
  assign palette = '#1a2236'
  if c != blank
    capture meta
      render 'flytz-destination-meta', collection: c
    endcapture
    assign m = meta | strip | split: '|'
    assign code = m[1]
    assign monument = m[2] | default: 'globe'
    assign palette = m[3] | default: '#1a2236'
  endif
  assign tz = 'now' | date: '%z'
  assign tz_iso = tz | slice: 0, 3
  assign tz_min = tz | slice: 3, 2
  assign departs = section.settings.departure | strip
  assign departs_iso = ''
  if departs != blank
    assign departs_iso = departs | replace: ' ', 'T' | append: ':00' | append: tz_iso | append: ':' | append: tz_min
  endif
  assign link = section.settings.button_link | default: c.url | default: routes.all_products_collection_url
  assign form_id = 'FlytzDepartureForm-' | append: section.id
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <section class="flytz-departure section-{{ section.id }}-padding" aria-labelledby="FlytzDepartureTitle-{{ section.id }}" style="--dest-tint: {{ palette }};">
    <div class="page-width flytz-departure__inner{{ reveal }}">
      <div class="flytz-departure__body">
        {%- if section.settings.eyebrow != blank -%}
          <p class="flytz-eyebrow">{{ section.settings.eyebrow | escape }}{% if code != blank %} · FLZ → {{ code }}{% endif %}</p>
        {%- endif -%}
        <h2 id="FlytzDepartureTitle-{{ section.id }}" class="flytz-title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="flytz-sub">{{ section.settings.text | escape }}</p>
        {%- endif -%}

        {%- if departs_iso != blank -%}
          <flytz-countdown class="flytz-countdown" data-departs="{{ departs_iso | escape }}" data-now-boarding="{{ 'flytz.departure.now_boarding' | t | escape }}">
            <p class="flytz-countdown__label">{{ 'flytz.departure.departs_in' | t }}</p>
            <div class="flytz-countdown__units" role="timer" aria-live="off">
              {%- assign units = 'days,hours,minutes,seconds' | split: ',' -%}
              {%- for unit in units -%}
                {%- assign unit_key = 'flytz.departure.' | append: unit -%}
                <div class="flytz-countdown__unit">
                  <span class="flytz-countdown__value" data-unit="{{ unit }}">00</span>
                  <small>{{ unit_key | t }}</small>
                </div>
              {%- endfor -%}
            </div>
            <p class="visually-hidden" data-countdown-text></p>
          </flytz-countdown>
        {%- endif -%}

        <div class="flytz-departure__actions">
          {%- if section.settings.show_notify -%}
            {%- form 'customer', id: form_id, class: 'flytz-departure__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter,next-departure{% if c != blank %},drop-{{ c.handle }}{% endif %}">
              {%- if form.posted_successfully? -%}
                <p class="flytz-departure__done" role="status" data-form-result>{{ 'flytz.departure.notified' | t }}</p>
              {%- endif -%}
              <div class="flytz-departure__fields" data-form-fields{% if form.posted_successfully? %} hidden{% endif %}>
                <label class="visually-hidden" for="FlytzDepartureEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
                <input
                  id="FlytzDepartureEmail-{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  required
                  autocomplete="email"
                  placeholder="{{ 'flytz.welcome.placeholder' | t | escape }}"
                  {% if form.errors %}
                    aria-invalid="true" aria-describedby="FlytzDepartureError-{{ section.id }}"
                  {% endif %}
                >
                <button type="submit" class="button">{{ section.settings.notify_label | escape }}</button>
                {%- if form.errors -%}
                  <p id="FlytzDepartureError-{{ section.id }}" class="flytz-departure__error" role="alert" data-form-result>
                    {{ form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email }}
                  </p>
                {%- endif -%}
              </div>
            {%- endform -%}
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <a class="button button--secondary" href="{{ link }}">{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>

      <div class="flytz-stage flytz-departure__stage is-drawing" aria-hidden="true">
        <div class="flytz-stage__tilt">{%- render 'flytz-monument', monument: monument -%}</div>
        <flytz-landmark monument="{{ monument }}" data-mode="stage" aria-hidden="true"></flytz-landmark>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Flytz next departure",
  "tag": "div",
  "class": "section flytz-section-departure",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Next departure"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Be first on board the next capsule"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Join the passenger list and we will email you the moment the next capsule boards."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Capsule collection",
      "info": "Sets the landmark, route code and button link."
    },
    {
      "type": "text",
      "id": "departure",
      "label": "Departure date and time",
      "placeholder": "2026-12-01 18:00",
      "info": "Format YYYY-MM-DD HH:MM, in your store's time zone. Leave empty to hide the countdown. After this time the section shows Now boarding."
    },
    {
      "type": "checkbox",
      "id": "show_notify",
      "label": "Show notify-me sign-up",
      "default": true,
      "info": "Adds the shopper to your customer list with the tags newsletter and next-departure."
    },
    {
      "type": "text",
      "id": "notify_label",
      "label": "Notify button label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link button label",
      "default": "Preview the capsule"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link button link",
      "info": "Leave empty to link to the capsule collection."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Flytz next departure"
    }
  ]
}
{% endschema %}
