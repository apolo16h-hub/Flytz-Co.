{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <section class="section-{{ section.id }}-padding">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <div class="flytz-head{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- if section.settings.eyebrow != blank -%}
            <p class="flytz-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="flytz-title">{{ section.settings.heading | escape }}</h2>
        </div>
      {%- endif -%}
      <div class="flytz-highlights">
        {%- for block in section.blocks -%}
          <div
            class="flytz-highlight{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <div class="flytz-highlight__icon">{%- render 'flytz-icon', icon: block.settings.icon -%}</div>
            <h3 class="flytz-highlight__title">{{ block.settings.title | escape }}</h3>
            <div class="flytz-highlight__text">{{ block.settings.text }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Flytz highlights",
  "tag": "div",
  "class": "section flytz-section-highlights",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "First class"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why travellers wear Flytz"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "star", "label": "Star" },
            { "value": "plane", "label": "Plane" },
            { "value": "globe", "label": "Globe" },
            { "value": "pin", "label": "Map pin" },
            { "value": "passport", "label": "Passport" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "lock", "label": "Lock" }
          ],
          "default": "star"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Limited capsule runs"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Each destination drop is numbered and never reprinted. When a flight is full, it's full.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Flytz highlights",
      "blocks": [
        {
          "type": "highlight",
          "settings": {
            "icon": "star",
            "title": "Limited capsule runs",
            "text": "<p>Each destination drop is numbered and never reprinted. When a flight is full, it's full.</p>"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "icon": "globe",
            "title": "Shipped worldwide",
            "text": "<p>Tracked delivery to six continents. Your order travels like you do.</p>"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "icon": "pin",
            "title": "Coordinates woven in",
            "text": "<p>Every piece carries the latitude and longitude of its inspiration, stitched inside the hem.</p>"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "icon": "leaf",
            "title": "Responsibly made",
            "text": "<p>Natural fibres and certified mills, chosen for each destination's craft tradition.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
