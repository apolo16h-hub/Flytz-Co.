{%- liquid
  assign destination = nil
  assign m = nil
  for c in product.collections
    capture meta
      render 'flytz-destination-meta', collection: c
    endcapture
    assign parts = meta | strip | split: '|'
    if parts[2] != 'globe' or c.metafields.flytz.monument != blank
      assign destination = c
      assign m = parts
      break
    endif
  endfor
  assign inspiration = product.metafields.flytz.inspiration.value
  assign coordinates = product.metafields.flytz.coordinates.value
  if coordinates == blank and m and m[4] != blank
    capture coordinates
      render 'flytz-coordinates', lat: m[4], lng: m[5]
    endcapture
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if destination -%}
  {%- capture stamp -%}{"handle": {{ destination.handle | json }}, "title": {{ destination.title | json }}, "code": {{ m[1] | default: '' | json }}, "url": {{ destination.url | json }}, "palette": {{ m[3] | json }}}{%- endcapture -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <section class="section-{{ section.id }}-padding" data-flytz-destination="{{ stamp | escape }}">
      <div class="page-width">
        <div
          class="flytz-pdest{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          style="--dest-tint: {{ m[3] }};"
        >
          <div class="flytz-stage is-drawing" aria-hidden="true">
            <div class="flytz-stage__tilt">{%- render 'flytz-monument', monument: m[2] -%}</div>
            <flytz-landmark monument="{{ m[2] }}" data-mode="stage" aria-hidden="true"></flytz-landmark>
          </div>
          <div class="flytz-pdest__body">
            <p class="flytz-eyebrow">{{ section.settings.eyebrow | escape }}</p>
            <h2 class="flytz-title">{{ destination.title | escape }}</h2>
            {%- assign tagline = destination.metafields.flytz.tagline.value | default: destination.description | strip_html | truncatewords: 40 -%}
            {%- if tagline != blank -%}
              <p class="flytz-sub">{{ tagline | escape }}</p>
            {%- endif -%}
            <dl class="flytz-pdest__facts">
              {%- if m[1] != blank -%}
                <div>
                  <dt><small>{{ 'flytz.product.route' | t }}</small></dt>
                  <dd><span>{{ section.settings.origin_code | default: 'FLZ' | escape }} → {{ m[1] }}</span></dd>
                </div>
              {%- endif -%}
              {%- if inspiration != blank -%}
                <div>
                  <dt><small>{{ 'flytz.product.inspiration' | t }}</small></dt>
                  <dd><span>{{ inspiration | escape }}</span></dd>
                </div>
              {%- endif -%}
              {%- if coordinates != blank -%}
                <div>
                  <dt><small>{{ 'flytz.product.coordinates' | t }}</small></dt>
                  <dd><span>{{ coordinates | escape }}</span></dd>
                </div>
              {%- endif -%}
              <div>
                <dt><small>{{ 'flytz.collection.capsule' | t }}</small></dt>
                <dd><span>{{ 'flytz.explorer.pieces_count' | t: count: destination.products_count }}</span></dd>
              </div>
            </dl>
            {%- comment -%}
              More from the same capsule, statement piece first: the higher-priced pieces put this
              one in context, and every card is a next step.
            {%- endcomment -%}
            {%- liquid
              assign siblings = destination.products | sort: 'price' | reverse
              assign shown = 0
            -%}
            {%- capture more -%}
              {%- for p in siblings -%}
                {%- if p.id == product.id or p.available == false -%}
                  {%- continue -%}
                {%- endif -%}
                <li>
                  <a class="flytz-pdest__piece" href="{{ p.url }}">
                    <span class="flytz-pdest__piece-media">
                      {%- if p.featured_media -%}
                        {{-
                          p.featured_media
                          | image_url: width: 240
                          | image_tag: loading: 'lazy', widths: '120, 240', sizes: '80px', alt: p.featured_media.alt
                        -}}
                      {%- endif -%}
                    </span>
                    <span class="flytz-pdest__piece-title">{{ p.title | escape }}</span>
                    <span class="flytz-pdest__piece-price">
                      {%- if p.compare_at_price > p.price -%}
                        <s>{{ p.compare_at_price | money }}</s>
                      {%- endif -%}
                      <span>{{ p.price | money }}</span>
                    </span>
                  </a>
                </li>
                {%- assign shown = shown | plus: 1 -%}
                {%- if shown == 3 -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- if shown > 0 -%}
              <div class="flytz-pdest__more">
                <p class="flytz-pdest__more-title">{{ 'flytz.product.more_from_capsule' | t: title: destination.title }}</p>
                <ul class="flytz-pdest__pieces">{{ more }}</ul>
              </div>
            {%- endif -%}
            <p class="flytz-pdest__cta">
              <a class="button button--secondary" href="{{ destination.url }}">
                {{- 'flytz.product.explore_capsule' | t: destination: destination.title -}}
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width section-{{ section.id }}-padding">
    <p class="flytz-sub">{{ 'flytz.product.editor_hint' | t }}</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Flytz destination story",
  "tag": "div",
  "class": "section flytz-section-product-destination",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the destination this product belongs to, using the first of its collections that is a destination. Add product metafields flytz.inspiration and flytz.coordinates for garment-specific detail."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Inspired by"
    },
    {
      "type": "text",
      "id": "origin_code",
      "label": "Origin code",
      "default": "FLZ"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Flytz destination story"
    }
  ]
}
{% endschema %}
