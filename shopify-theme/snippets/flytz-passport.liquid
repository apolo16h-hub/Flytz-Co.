{%- comment -%}
  Flytz Passport: shoppers collect a stamp for every destination capsule they open (explorer
  panel or collection page). Stamps live in the shopper's own browser. Reaching the milestone in
  Theme settings → Flytz reveals the optional reward code. Rendered from layout/theme.liquid.
{%- endcomment -%}
{%- capture strings -%}
  {
    "stamped": {{ 'flytz.passport.stamped' | t | json }},
    "progress": {{ 'flytz.passport.progress' | t: n: '[n]', total: '[total]' | json }},
    "milestone": {{ 'flytz.passport.milestone' | t: n: '[n]' | json }},
    "unlocked": {{ 'flytz.passport.unlocked' | t | json }},
    "next": {{ 'flytz.passport.next' | t: n: '[n]' | json }},
    "statuses": [
      {{ 'flytz.passport.status_1' | t | json }},
      {{ 'flytz.passport.status_2' | t | json }},
      {{ 'flytz.passport.status_3' | t | json }},
      {{ 'flytz.passport.status_4' | t | json }}
    ],
    "copy": {{ 'flytz.welcome.copy' | t | json }},
    "copied": {{ 'flytz.welcome.copied' | t | json }}
  }
{%- endcapture -%}
<flytz-passport
  class="flytz-passport"
  data-threshold="{{ settings.flytz_passport_threshold }}"
  data-code="{{ settings.flytz_passport_code | escape }}"
  data-reward="{{ settings.flytz_passport_reward | escape }}"
  data-strings="{{ strings | strip | escape }}"
>
  <button
    type="button"
    class="flytz-passport__toggle"
    aria-haspopup="dialog"
    aria-controls="FlytzPassportDialog"
    hidden
  >
    <svg class="flytz-passport__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="5" y="3" width="14" height="18" rx="2"/>
      <circle cx="12" cy="10" r="3.2"/>
      <path d="M8.8 10h6.4M12 6.8c1.3 1.2 1.3 5.2 0 6.4M12 6.8c-1.3 1.2-1.3 5.2 0 6.4M9 17h6"/>
    </svg>
    <span class="flytz-passport__toggle-label">{{ 'flytz.passport.title' | t }}</span>
    <b class="flytz-passport__count" data-passport-count>0</b>
  </button>

  <div class="flytz-passport__toast" data-passport-toast role="status" aria-live="polite" hidden></div>

  <div
    id="FlytzPassportDialog"
    class="flytz-passport__overlay"
    data-passport-overlay
    hidden
  >
    <div class="flytz-passport__book" role="dialog" aria-modal="true" aria-labelledby="FlytzPassportTitle">
      <header class="flytz-passport__head">
        <span class="flytz-passport__issuer">{{ shop.name | escape }}</span>
        <button type="button" class="flytz-passport__close" data-passport-close aria-label="{{ 'accessibility.close' | t | escape }}">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </header>
      <p class="flytz-eyebrow">{{ 'flytz.passport.eyebrow' | t }}</p>
      <h2 id="FlytzPassportTitle" class="flytz-passport__title">{{ 'flytz.passport.heading' | t }}</h2>
      <p class="flytz-passport__status" data-passport-status></p>
      <div class="flytz-passport__bar" aria-hidden="true"><span data-passport-bar></span></div>
      <p class="flytz-passport__progress" data-passport-progress></p>
      <div class="flytz-passport__perk" data-passport-perk hidden></div>
      <ol class="flytz-passport__stamps" data-passport-stamps></ol>
      <p class="flytz-passport__empty" data-passport-empty>{{ 'flytz.passport.empty' | t }}</p>
    </div>
  </div>
</flytz-passport>
