{%- comment -%}
  Renders a line-art landmark for a destination.

  Accepts:
  - monument: {String} landmark key (eiffel, bigben, colosseum, parthenon, fuji, greatwall,
    tajmahal, burj, pyramids, koutoubia, liberty, chichen, redeemer, machu, opera). Anything else renders a globe.
  - class_name: {String} extra classes (optional)

  Usage:
  {% render 'flytz-monument', monument: 'eiffel' %}
{%- endcomment -%}
{%- liquid
  assign vb = '0 0 200 240'
  case monument
    when 'colosseum', 'fuji'
      assign vb = '0 0 200 230'
    when 'tajmahal'
      assign vb = '0 0 200 210'
    when 'pyramids', 'machu'
      assign vb = '0 0 200 222'
    when 'koutoubia', 'liberty'
      assign vb = '0 0 200 226'
    when 'chichen', 'greatwall'
      assign vb = '0 0 200 190'
    when 'redeemer'
      assign vb = '0 0 200 220'
    when 'opera'
      assign vb = '0 0 200 214'
    when 'parthenon'
      assign vb = '0 0 200 200'
  endcase
-%}
<svg
  class="flytz-monument{% if class_name != blank %} {{ class_name }}{% endif %}"
  viewBox="{{ vb }}"
  aria-hidden="true"
  focusable="false"
  data-monument="{{ monument | default: 'globe' }}"
>
  {%- case monument -%}
