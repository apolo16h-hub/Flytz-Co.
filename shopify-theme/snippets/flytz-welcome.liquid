{%- comment -%}
  Welcome offer styled as a boarding pass: a non-blocking card that slides in after a short
  delay, at 60% scroll, or when a desktop shopper heads for the address bar. Sign-ups use
  Shopify's own customer form (tagged "newsletter, flytz-welcome"); the optional code in
  Theme settings → Flytz is revealed after signing up. Rendered from layout/theme.liquid.
{%- endcomment -%}
<aside
  class="flytz-welcome"
  data-flytz-welcome
  data-delay="{{ settings.flytz_welcome_delay }}"
  role="dialog"
  aria-modal="false"
  aria-labelledby="FlytzWelcomeTitle"
  hidden
>
  <div class="flytz-welcome__pass">
    <button type="button" class="flytz-welcome__close" data-welcome-close aria-label="{{ 'accessibility.close' | t | escape }}">
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>
    <div class="flytz-welcome__main">
      <p class="flytz-welcome__eyebrow">{{ 'flytz.welcome.eyebrow' | t }}</p>
      <h2 id="FlytzWelcomeTitle" class="flytz-welcome__title">{{ settings.flytz_welcome_heading | escape }}</h2>
      {%- if settings.flytz_welcome_text != blank -%}
        <p class="flytz-welcome__text">{{ settings.flytz_welcome_text | escape }}</p>
      {%- endif -%}
      {%- comment -%}
        The shopper fills in their own pass: name and destination show on the ticket as they go.
        The destination list and its default (quiz match or last capsule explored) come from
        assets/flytz-hooks.js; the choice is added to the sign-up as a dream-<handle> tag.
      {%- endcomment -%}
      <div class="flytz-welcome__route">
        <div class="flytz-welcome__cell flytz-welcome__cell--passenger">
          <label class="flytz-welcome__label" for="FlytzWelcomeName">{{ 'flytz.welcome.passenger' | t }}</label>
          <input
            id="FlytzWelcomeName"
            class="flytz-welcome__name"
            type="text"
            name="contact[first_name]"
            form="FlytzWelcomeForm"
            autocomplete="given-name"
            maxlength="40"
            placeholder="{{ 'flytz.welcome.name_placeholder' | t | escape }}"
            value="{{ customer.first_name | escape }}"
          >
        </div>
        <div class="flytz-welcome__cell">
          <span class="flytz-welcome__label">{{ 'flytz.welcome.from' | t }}</span>
          <span class="flytz-welcome__value">FLZ</span>
        </div>
        <span class="flytz-welcome__plane" aria-hidden="true">{{- 'icon-plane.svg' | inline_asset_content -}}</span>
        <div class="flytz-welcome__cell flytz-welcome__cell--to">
          <label class="flytz-welcome__label" for="FlytzWelcomeTo">{{ 'flytz.welcome.to' | t }}</label>
          <span class="flytz-welcome__value" data-welcome-to-static>{{ 'flytz.welcome.anywhere' | t }}</span>
          <select id="FlytzWelcomeTo" class="flytz-welcome__value flytz-welcome__to" data-welcome-to hidden>
            <option value="">{{ 'flytz.welcome.anywhere' | t }}</option>
          </select>
        </div>
        <div class="flytz-welcome__cell">
          <span class="flytz-welcome__label">{{ 'flytz.welcome.seat' | t }}</span>
          <span class="flytz-welcome__value">1A</span>
        </div>
      </div>

      {%- form 'customer', id: 'FlytzWelcomeForm', class: 'flytz-welcome__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,flytz-welcome" data-welcome-tags>
        {%- if form.posted_successfully? -%}
          <div class="flytz-welcome__success" data-welcome-success data-form-result role="status">
            <p>{{ 'flytz.welcome.success' | t }}</p>
            {%- if settings.flytz_welcome_code != blank -%}
              <p class="flytz-welcome__code">
                <span class="flytz-welcome__code-label">{{ 'flytz.welcome.your_code' | t }}</span>
                <strong data-welcome-code>{{ settings.flytz_welcome_code | escape }}</strong>
                <button type="button" class="flytz-welcome__copy" data-welcome-copy data-copied="{{ 'flytz.welcome.copied' | t | escape }}">
                  {{- 'flytz.welcome.copy' | t -}}
                </button>
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}
        <div class="flytz-welcome__fields" data-form-fields{% if form.posted_successfully? %} hidden{% endif %}>
          <div class="flytz-welcome__field">
            <label class="visually-hidden" for="FlytzWelcomeEmail">{{ 'newsletter.label' | t }}</label>
            <input
              id="FlytzWelcomeEmail"
              type="email"
              name="contact[email]"
              required
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              placeholder="{{ 'flytz.welcome.placeholder' | t | escape }}"
              value="{{ form.email | default: customer.email | escape }}"
              {% if form.errors %}
                aria-invalid="true" aria-describedby="FlytzWelcomeError"
              {% endif %}
            >
            <button type="submit" class="button">{{ 'flytz.welcome.submit' | t }}</button>
          </div>
          {%- if form.errors -%}
            <p id="FlytzWelcomeError" class="flytz-welcome__error" data-welcome-error data-form-result role="alert">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
          <p class="flytz-welcome__fine">{{ 'flytz.welcome.fine' | t }}</p>
        </div>
      {%- endform -%}
    </div>
    <div class="flytz-welcome__stub" aria-hidden="true">
      <span>{{ 'flytz.welcome.gate' | t: gate: settings.flytz_boarding_gate }}</span>
      <span class="flytz-welcome__barcode"></span>
    </div>
  </div>
</aside>
